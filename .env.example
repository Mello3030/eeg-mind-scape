# ---- Frontend (Vite) ----
# Base URL of the QSFE-Net API (ML/backend). No trailing /api - the client adds
# the per-route prefixes itself, and also calls unprefixed routes like /health.
VITE_API_URL=http://localhost:8000

# Everything else - checkpoint, dataset paths, database, JWT secret - is server
# configuration and lives in ML/backend/.env. See ML/backend/.env.example.
