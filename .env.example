# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:4000/api

# ---- Express API (reference backend) ----
DATABASE_URL=postgresql://qsfe:qsfe@localhost:5432/qsfe
JWT_SECRET=change-me-in-production
ML_SERVICE_URL=http://localhost:8000
PORT=4000

# ---- Python FastAPI ML service ----
# When true the service returns clearly-labelled demo predictions instead of
# loading the trained PyTorch checkpoint. The UI marks every such result as
# demo data and never presents it as real model output.
MOCK_INFERENCE=true
CHECKPOINT_PATH=checkpoints/qsfe_net_run8.pth